{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation error",
  "description": "422 for a request body, path or query parameter that fails validation.",
  "type": "object",
  "required": ["detail"],
  "additionalProperties": false,
  "properties": {
    "detail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["loc", "msg", "type"],
        "properties": {
          "loc": { "type": "array", "items": { "type": ["string", "integer"] } },
          "msg": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
