DATABASE_URL=postgresql://houseplant:houseplant@localhost:5432/houseplant

# Who issues bearer tokens. Under docker compose, compose.env already points these at the
# clerk-mock service, so leave them commented out. To use a real Clerk instance instead (its
# "Frontend API URL" from the Clerk dashboard), uncomment all three:
# AUTH_ISSUER=https://your-app.clerk.accounts.dev
# Empty means {AUTH_ISSUER}/.well-known/jwks.json, which is where Clerk publishes it:
# AUTH_JWKS_URL=
# AUTH_AUTHORIZED_PARTIES=http://localhost:5173
#
# Running the backend on the host (make dev) with clerk-mock needs the mock's host port instead;
# `make dev` sets these for you when AUTH_ISSUER isn't set here.

# Optional: give your own Clerk user the demo trips when seeding (`make seed`).
# SEED_DEMO_USER_ID=user_...

# Comma-separated frontend origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:5173

# UKHO tidal API. Leave commented out to use the WireMock stand-in under docker compose
# (see compose.env). On the host without these, /windsurf returns 503. To use the real API:
# UKHO_BASE_URL=https://admiraltyapi.azure-api.net/uktidalapi/api/V1
# UKHO_API_KEY=your-key
