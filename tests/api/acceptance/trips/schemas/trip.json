{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trip",
  "description": "A trip, as every signed-in user sees it: every day has a real date, and stays and bookings are always lists.",
  "type": "object",
  "required": ["id", "title", "days", "stays", "bookings"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "days": { "type": "array", "items": { "$ref": "#/$defs/day" } },
    "stays": { "type": "array", "items": { "$ref": "#/$defs/stay" } },
    "bookings": { "type": "array", "items": { "$ref": "#/$defs/booking" } }
  },
  "$defs": {
    "day": {
      "type": "object",
      "required": ["dayNumber", "date", "stops"],
      "additionalProperties": false,
      "properties": {
        "dayNumber": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "stops": { "type": "array", "items": { "$ref": "#/$defs/stop" } }
      }
    },
    "stop": {
      "type": "object",
      "required": ["id", "place"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "place": { "$ref": "place.json" }
      }
    },
    "stay": {
      "type": "object",
      "required": ["id", "place", "firstNight", "nights"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "place": { "$ref": "place.json" },
        "firstNight": { "type": "integer", "minimum": 1 },
        "nights": { "type": "integer", "minimum": 1 }
      }
    },
    "booking": {
      "type": "object",
      "required": ["id", "place", "stopId", "stayId", "reference", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "place": { "$ref": "place.json" },
        "stopId": { "type": ["string", "null"], "format": "uuid" },
        "stayId": { "type": ["string", "null"], "format": "uuid" },
        "reference": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "not": {
        "description": "A booking is for at most one of a stop or a stay.",
        "properties": { "stopId": { "type": "string" }, "stayId": { "type": "string" } }
      }
    }
  }
}
