{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error",
  "description": "Any 4xx/5xx raised by an API (other than request validation).",
  "type": "object",
  "required": ["detail"],
  "additionalProperties": false,
  "properties": {
    "detail": { "type": "string", "minLength": 1 }
  }
}
