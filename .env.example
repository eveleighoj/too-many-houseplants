DATABASE_URL=postgresql://houseplant:houseplant@localhost:5432/houseplant

# --- Signing in ---------------------------------------------------------------------------
# By default the local stack signs in with clerk-mock's dev users (docker/compose.env), so leave
# this section commented out.
#
# Signing in with a real Clerk instance instead (e.g. your Clerk development instance): uncomment
# all five, then `make up`. The frontend uses Clerk's sign-in, and the api trusts that instance.
# The instance's Frontend API URL:
# AUTH_ISSUER=https://your-instance.clerk.accounts.dev
# Keep empty: derived from AUTH_ISSUER.
# AUTH_JWKS_URL=
# AUTH_AUTHORIZED_PARTIES=http://localhost:5173
# Keep empty: there are no clerk-mock tokens to link to.
# AUTH_DEV_TOKENS_URL=
# The instance's publishable key (public), read by the frontend container:
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
#
# Running the api on the host (make dev) with clerk-mock needs the mock's host port instead;
# `make dev` sets these for you when AUTH_ISSUER isn't set here.

# Optional: give your own Clerk user the demo trips when seeding (`make seed`).
# SEED_DEMO_USER_ID=user_...
# SEED_FRIEND_USER_ID=user_...

# Comma-separated frontend origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:5173

# UKHO tidal API. Leave commented out to use the WireMock stand-in under docker compose
# (see docker/compose.env). On the host without these, /windsurf returns 503. To use the real API:
# UKHO_BASE_URL=https://admiraltyapi.azure-api.net/uktidalapi/api/V1
# UKHO_API_KEY=your-key
