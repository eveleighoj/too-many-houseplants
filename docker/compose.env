# Defaults for the api containers in docker-compose.yml. Your .env (repo root) is loaded after
# this file, so anything set there overrides these (e.g. a real UKHO key and URL).
# DATABASE_URL isn't here: it's forced to the db service in docker-compose.yml, because
# .env points it at localhost for running on the host.

# Trust the clerk-mock token issuer (see docker/wiremock/clerk/) instead of Clerk. Tokens carry
# iss=http://localhost:8082 (where the browser sees the mock); the API fetches the keys over the
# compose network. To use a real Clerk instance instead, see the AUTH_* lines in
# .env.example.
AUTH_ISSUER=http://localhost:8082
AUTH_JWKS_URL=http://clerk-mock:8080/.well-known/jwks.json
AUTH_AUTHORIZED_PARTIES=http://localhost:5173
# The API docs link here for "Authorize": a page of dev users' tokens with copy buttons.
AUTH_DEV_TOKENS_URL=http://localhost:8082

# Use the WireMock stand-in for the UKHO tidal API (see docker/wiremock/ukho/). It accepts any key.
UKHO_BASE_URL=http://ukho-mock:8080
UKHO_API_KEY=local-mock-key
